{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "paths": {
      "@guidomodarelli/beez-ui": ["../dist/index"],
      "@guidomodarelli/beez-ui/tanstack": ["../dist/tanstack"],
      "@guidomodarelli/beez-ui/hooks": ["../dist/hooks"]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../.storybook/**/*.ts",
    "../.storybook/**/*.tsx",
    "../playwright.storybook.config.ts"
  ]
}

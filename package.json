{
  "name": "beez-ui",
  "version": "0.1.0",
  "description": "Shared UI components with the customizations extracted from TuTribu.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "styles.css",
    "components.json",
    "LICENSE.md",
    "theme.css",
    "fonts.css",
    "assets"
  ],
  "exports": {
    "./alert-dialog": "./src/components/alert-dialog.tsx",
    "./avatar": "./src/components/avatar.tsx",
    "./badge": "./src/components/badge.tsx",
    "./button": "./src/components/button.tsx",
    "./card": "./src/components/card.tsx",
    "./carousel": "./src/components/carousel.tsx",
    "./checkbox": "./src/components/checkbox.tsx",
    "./dialog": "./src/components/dialog.tsx",
    "./dropdown-menu": "./src/components/dropdown-menu.tsx",
    "./hover-card": "./src/components/hover-card.tsx",
    "./input": "./src/components/input.tsx",
    "./pagination": "./src/components/pagination.tsx",
    "./popover": "./src/components/popover.tsx",
    "./select": "./src/components/select.tsx",
    "./separator": "./src/components/separator.tsx",
    "./sheet": "./src/components/sheet.tsx",
    "./sidebar": "./src/components/sidebar.tsx",
    "./skeleton": "./src/components/skeleton.tsx",
    "./switch": "./src/components/switch.tsx",
    "./table": "./src/components/table.tsx",
    "./tabs": "./src/components/tabs.tsx",
    "./textarea": "./src/components/textarea.tsx",
    "./tooltip": "./src/components/tooltip.tsx",
    "./svgs/whatsappIcon": "./src/components/svgs/whatsappIcon.tsx",
    "./utils": "./src/lib/utils.ts",
    "./use-mobile": "./src/hooks/use-mobile.ts",
    "./sidebar-constants": "./src/constants/sidebar.ts",
    "./sonner": "./src/sonner.ts",
    "./styles.css": "./styles.css",
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./alert": "./src/components/alert.tsx",
    "./animated-theme-toggler": "./src/components/animated-theme-toggler.tsx",
    "./calendar": "./src/components/calendar.tsx",
    "./data-table": "./src/components/data-table.tsx",
    "./filter-query-bar": "./src/components/filter-query-bar.tsx",
    "./filter-query-grammar": "./src/components/filter-query-grammar.ts",
    "./form": "./src/components/form.tsx",
    "./highlighter": "./src/components/highlighter.tsx",
    "./input-group": "./src/components/input-group.tsx",
    "./label": "./src/components/label.tsx",
    "./radio-group": "./src/components/radio-group.tsx",
    "./typing-animation": "./src/components/typing-animation.tsx",
    "./themed-toaster": "./src/components/themed-toaster.tsx",
    "./theme.css": "./theme.css",
    "./fonts.css": "./fonts.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guidomodarelli/beez-ui.git"
  },
  "scripts": {
    "typecheck": "pnpm typecheck:src && pnpm typecheck:tests",
    "typecheck:src": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "eslint .",
    "test:browser": "playwright test"
  },
  "peerDependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.2.0",
    "embla-carousel-react": "^8.6.0",
    "motion": "^12.38.0",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.0",
    "react-hook-form": "^7.75.0",
    "rough-notation": "^0.5.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12 <13"
  }
}
